# ARENA - Environment Configuration Example
# Copy this file to .env and fill in your keys.

# Google Gemini API key (Required for Intelligence Core)
# Get one free at: https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here

# NVIDIA NIM API key (Optional - Fallback provider)
# Get one free at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here

# Server Settings
ARENA_PORT=8000
ARENA_HOST=0.0.0.0
ARENA_VERBOSE=true
